// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree for MXQ 4K H3Q44 V3.0 TV box, ported from the Android
 * 7.0 Allwinner vendor DTB found in ROM-MXQ-4K-H3Q44_V3.0_20190838.img.
 */

/dts-v1/;
#include "sun8i-h3.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "MXQ 4K H3Q44 V3.0";
	compatible = "mxq,h3q44", "allwinner,sun8i-h3";

	aliases {
		serial0 = &uart0;
		ethernet0 = &emac;
		ethernet1 = &sdio_wifi;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		status_led {
			label = "mxq:blue:status";
			gpios = <&pio 0 15 GPIO_ACTIVE_LOW>; /* PA15 */
			default-state = "on";
		};
	};

	r_gpio_keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&power_button_pin>;

		power {
			label = "power";
			linux,code = <KEY_POWER>;
			gpios = <&r_pio 0 3 GPIO_ACTIVE_LOW>; /* PL3 */
			wakeup-source;
			debounce-interval = <10>;
		};
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>; /* PL7 */
	};
};

&de {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&emac {
	phy-handle = <&int_mii_phy>;
	phy-mode = "mii";
	allwinner,leds-active-low;
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&ir {
	pinctrl-names = "default";
	pinctrl-0 = <&r_ir_rx_pin>;
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	status = "okay";
};

&mmc1 {
	vmmc-supply = <&reg_vcc3v3>;
	vqmmc-supply = <&reg_vcc3v3>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;
	status = "okay";

	sdio_wifi: wifi@1 {
		reg = <1>;
		/* SV6256P / SSV6X5X, enumerated by SDIO ID 3030:3030. */
		interrupt-parent = <&pio>;
		interrupts = <0 11 IRQ_TYPE_LEVEL_LOW>; /* PA11 */
		interrupt-names = "host-wake";
	};
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_vcc3v3>;
	vqmmc-supply = <&reg_vcc3v3>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "disabled";
};

&mmc2_8bit_pins {
	drive-strength = <40>;
	bias-pull-up;
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

&pio {
	nand_pins: nand-pins {
		pins = "PC0", "PC1", "PC2", "PC5",
		       "PC8", "PC9", "PC10", "PC11",
		       "PC12", "PC13", "PC14", "PC15";
		function = "nand0";
	};

	nand_cs0_pin: nand-cs0-pin {
		pins = "PC4";
		function = "nand0";
		bias-pull-up;
	};

	nand_rb0_pin: nand-rb0-pin {
		pins = "PC6";
		function = "nand0";
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "PA15";
		function = "gpio_out";
	};
};

&r_pio {
	power_button_pin: power-button-pin {
		pins = "PL3";
		function = "gpio_in";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

&usb_otg {
	dr_mode = "otg";
	status = "okay";
};

&usbphy {
	status = "okay";
};

&{/soc} {
	nfc: nand-controller@1c03000 {
		compatible = "allwinner,sun8i-a23-nand-controller";
		reg = <0x01c03000 0x1000>;
		interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_NAND>, <&ccu CLK_NAND>;
		clock-names = "ahb", "mod";
		resets = <&ccu RST_BUS_NAND>;
		reset-names = "ahb";
		dmas = <&dma 5>;
		dma-names = "rxtx";
		pinctrl-names = "default";
		pinctrl-0 = <&nand_pins &nand_cs0_pin &nand_rb0_pin>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		nand@0 {
			reg = <0>;
			allwinner,rb = <0>;
			nand-ecc-mode = "hw";
			nand-ecc-algo = "bch";
			nand-ecc-step-size = <1024>;
			nand-ecc-strength = <40>;
		};
	};
};
